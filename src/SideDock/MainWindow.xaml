<Window x:Class="SideDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SideDock"
        Width="430"
        Height="720"
        MinWidth="72"
        MinHeight="320"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="#101318"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <Grid x:Name="Root">
        <Grid x:Name="ShellGrid"
              Background="#101318">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="72" />
                <ColumnDefinition x:Name="ContentColumn" Width="*" />
                <ColumnDefinition x:Name="ResizeColumn" Width="18" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#151922"
                    BorderBrush="#262D3A"
                    BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top"
                                Margin="10,12,10,8">
                        <TextBlock Text="SD"
                                   HorizontalAlignment="Center"
                                   Foreground="#F4F7FB"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />

                        <ToggleButton x:Name="PinButton"
                                      Height="38"
                                      Margin="0,0,0,8"
                                      ToolTip="Pin sidebar"
                                      Checked="OnPinChanged"
                                      Unchecked="OnPinChanged">
                            <TextBlock Text="PIN"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </ToggleButton>

                        <ToggleButton x:Name="TopmostButton"
                                      Height="38"
                                      Margin="0,0,0,8"
                                      ToolTip="Keep on top"
                                      Checked="OnTopmostChanged"
                                      Unchecked="OnTopmostChanged">
                            <TextBlock Text="TOP"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </ToggleButton>
                    </StackPanel>

                    <ListBox x:Name="ToolList"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#E8EDF5"
                             SelectionChanged="OnToolSelectionChanged"
                             PreviewMouseLeftButtonUp="OnToolListMouseLeftButtonUp"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="8,4" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Height="48"
                                                    CornerRadius="6"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#232A36" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#2C7DFA" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IconKey}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           ToolTip="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid x:Name="ContentPanel"
                  Grid.Column="1"
                  Background="#0B0D11">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#111722"
                        BorderBrush="#262D3A"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       Text="SideDock"
                                       Foreground="#F4F7FB"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="UrlText"
                                       Text=""
                                       Foreground="#8D98AA"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="BackButton"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Content="&lt;"
                                    ToolTip="Back"
                                    Click="OnBackClick" />
                            <Button x:Name="ForwardButton"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Content="&gt;"
                                    ToolTip="Forward"
                                    Click="OnForwardClick" />
                            <Button Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Content="R"
                                    ToolTip="Refresh"
                                    Click="OnRefreshClick" />
                            <Button Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Content="O"
                                    ToolTip="Open externally"
                                    Click="OnOpenExternalClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="BrowserHost"
                      Grid.Row="1"
                      Background="#0B0D11" />

                <Border Grid.Row="2"
                        Background="#111722"
                        BorderBrush="#262D3A"
                        BorderThickness="0,1,0,0">
                    <TextBlock x:Name="StatusText"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               Foreground="#AAB4C4"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Text="Starting..." />
                </Border>
            </Grid>

            <Border x:Name="ResizeGrip"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Background="#01000000"
                    Panel.ZIndex="20"
                    Cursor="SizeWE"
                    ToolTip="Drag to resize"
                    MouseLeftButtonDown="OnResizeGripMouseLeftButtonDown"
                    MouseMove="OnResizeGripMouseMove"
                    MouseLeftButtonUp="OnResizeGripMouseLeftButtonUp" />
        </Grid>
    </Grid>
</Window>
