<Window x:Class="SideDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SideDock"
        Width="430"
        Height="720"
        MinWidth="48"
        MinHeight="320"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="HeaderIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#D8DEE9" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#232A36" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#364153" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#2C7DFA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderToggleButtonStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#D8DEE9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#232A36" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#364153" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#2C7DFA" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#4A91FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid x:Name="ShellGrid"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ContentColumn" Width="*" />
                <ColumnDefinition x:Name="ResizeColumn" Width="18" />
                <ColumnDefinition x:Name="RailColumn" Width="48" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="2"
                    Background="#33FFFFFF"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1,0,0,0">
                <DockPanel LastChildFill="True">
                    <ListBox x:Name="ToolList"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#E8EDF5"
                             SelectionChanged="OnToolSelectionChanged"
                             PreviewMouseLeftButtonUp="OnToolListMouseLeftButtonUp"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Margin="4,10,4,10">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,4" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Height="48"
                                                    CornerRadius="6"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#33FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#2C7DFA" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="24"
                                      Height="24"
                                      ToolTip="{Binding Tool.Title}">
                                    <Border x:Name="DefaultIcon"
                                            Width="24"
                                            Height="24"
                                            CornerRadius="0"
                                            Background="#222A36"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="&#xE774;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="#D8DEE9"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Image x:Name="SiteIcon"
                                           Width="24"
                                           Height="24"
                                           Source="{Binding Icon}"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                        <Setter TargetName="SiteIcon" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                        <Setter TargetName="DefaultIcon" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid x:Name="ContentPanel"
                  Grid.Column="0"
                  Background="#0B0D11">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#111722"
                        BorderBrush="#262D3A"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       Text="SideDock"
                                       Foreground="#F4F7FB"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="UrlText"
                                       Text=""
                                       Foreground="#8D98AA"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource HeaderIconButtonStyle}"
                                    Content="&#xE8A7;"
                                    ToolTip="Open externally"
                                    Click="OnOpenExternalClick" />
                            <ToggleButton x:Name="PinButton"
                                          Style="{StaticResource HeaderToggleButtonStyle}"
                                          ToolTip="Pin sidebar"
                                          Checked="OnPinChanged"
                                          Unchecked="OnPinChanged">
                                <TextBlock x:Name="PinIconText"
                                           Text="&#xE77A;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" />
                            </ToggleButton>
                            <Button Style="{StaticResource HeaderIconButtonStyle}"
                                    Content="&#xE921;"
                                    ToolTip="Hide"
                                    Click="OnHideClick" />
                            <Button Style="{StaticResource HeaderIconButtonStyle}"
                                    Content="&#xE8BB;"
                                    ToolTip="Close page"
                                    Click="OnClosePageClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="BrowserHost"
                      Grid.Row="1"
                      Background="#0B0D11" />
            </Grid>

            <Border x:Name="ResizeGrip"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Background="#01000000"
                    Panel.ZIndex="20"
                    Cursor="SizeWE"
                    ToolTip="Drag to resize"
                    MouseLeftButtonDown="OnResizeGripMouseLeftButtonDown"
                    MouseMove="OnResizeGripMouseMove"
                    MouseLeftButtonUp="OnResizeGripMouseLeftButtonUp" />
        </Grid>
    </Grid>
</Window>
